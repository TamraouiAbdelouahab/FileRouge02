@startuml
left to right direction

actor surveillant_generale as "Surveillant générale"


rectangle "Sprint 1 - gérer les justifications" {
  usecase "Consulter les justificatifs reçus" as UC1
  usecase "Ajouter un justificatif" as UC2
  usecase "Afficher les détails d'un justificatif" as UC3
  usecase "Accepter un justificatif" as UC4
  usecase "Rejeter un justificatif" as UC5
}

surveillant_generale -- UC1
surveillant_generale -- UC2
surveillant_generale -- UC3
surveillant_generale -- UC4
surveillant_generale -- UC5

@enduml